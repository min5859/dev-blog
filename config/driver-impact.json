{
  "profile": {
    "id": "exynos-camera",
    "title": "카메라·Exynos 드라이버",
    "reader": "arm64 Exynos SoC에서 카메라(V4L2·미디어 컨트롤러) 디바이스 드라이버를 맡은 개발자",
    "arch": [
      "arm64",
      "arm"
    ],
    "foreignSources": "^(?:drivers/(?:acpi|platform/x86|xen|hv|s390|parisc|macintosh|sbus|firmware/efi)/|include/(?:acpi|xen)/|include/linux/(?:acpi|efi|dmi)[\\w-]*\\.h$)",
    "groups": [
      {
        "id": "camera",
        "label": "미디어",
        "describe": "drivers/media의 platform·i2c·v4l2-core·videobuf2·mc",
        "proxy": true,
        "paths": "^drivers/(?:staging/)?media/(?:platform|i2c|v4l2-core|common/videobuf2|mc)/"
      },
      {
        "id": "exynos",
        "label": "Exynos",
        "describe": "Samsung SoC의 clk·pinctrl·phy·pmdomain·soc·iommu 등",
        "paths": "^drivers/(?:(?:clk|firmware|interconnect|memory|phy|pinctrl|pmdomain|soc|thermal)/samsung/|iommu/exynos-iommu\\.|devfreq/exynos-bus\\.|devfreq/event/exynos-|i2c/busses/i2c-(?:exynos5|s3c2410)\\.|spi/spi-s3c64xx\\.|clocksource/exynos_mct\\.|irqchip/exynos-combiner\\.|mailbox/exynos-mailbox\\.)"
      }
    ],
    "primaryAreas": [
      "v4l2"
    ],
    "pulls": {
      "tags": "^media/",
      "keywords": "\\b(?:exynos\\w*|samsung)\\b"
    },
    "genericSubsystems": 5,
    "extraAreas": [
      {
        "id": "samsung-soc",
        "title": "Samsung SoC 헤더",
        "headers": "^include/linux/(?:soc/samsung/|mfd/samsung/|firmware/samsung/|clk/samsung\\.h$)",
        "sources": "^drivers/(?:soc|firmware)/samsung/",
        "pulls": "^samsung-"
      }
    ]
  }
}
