[Unit]
Description=Dev Blog daily content generation and GitHub Pages trigger
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=devblog
Group=devblog
WorkingDirectory=/srv/dev-blog
Environment=HOME=/home/devblog
Environment=PATH=/home/devblog/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PROJECT_DIR=/srv/dev-blog
Environment=NPM_BIN=/usr/local/bin/npm
Environment=CURSOR_AGENT_BIN=/home/devblog/.local/bin/agent
Environment=GIT_TERMINAL_PROMPT=0
ExecStartPre=/usr/bin/test -x /usr/local/bin/node
ExecStartPre=/usr/bin/test -x /home/devblog/.local/bin/agent
ExecStartPre=/usr/bin/git -C /srv/dev-blog pull --ff-only origin main
ExecStart=/srv/dev-blog/scripts/daily-deploy.sh
TimeoutStartSec=6h
KillMode=mixed
UMask=0022
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dev-blog
